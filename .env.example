# Aurora FileShare configuration. Copy to .env and adjust.

# Bind address and port for the Node process. Behind a Cloudflare Tunnel there
# is no reason to expose this beyond localhost/LAN.
HOST=0.0.0.0
PORT=8080

# Public origin, used only for logging and diagnostics.
PUBLIC_URL=https://fileshare.aurorahosting.nl

# Read the real client IP from X-Forwarded-For. Correct behind cloudflared.
TRUST_PROXY=true

# How long a share survives without activity.
CHANNEL_TTL_MINUTES=240

# Ceiling on simultaneous live shares (memory is a few KB each).
MAX_CHANNELS=5000

# New shares per IP per minute.
HOST_RATE_LIMIT=20

# Advisory per-file cap shown to the sender. 0 disables the check entirely.
# The server never sees the bytes, so this is a UI guard, not enforcement.
MAX_FILE_SIZE_GB=0

# STUN lets peers discover their public address. Comma separated.
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# TURN relays traffic when both peers are behind restrictive NAT. Optional.
#
# Important: TURN cannot run through a Cloudflare Tunnel - it needs a directly
# reachable UDP port. Enabling this means exposing coturn some other way (a port
# forward, or a small VPS). Without it, a minority of peer pairs cannot connect.
#TURN_URL=turn:turn.aurorahosting.nl:3478
#TURN_USERNAME=
#TURN_CREDENTIAL=
